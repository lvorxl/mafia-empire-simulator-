<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Choose School - Dynasty Manager</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #0a0e1a 0%, #1a2332 100%);
            color: white;
            min-height: 100vh;
            padding: 2rem;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        h1 {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: #ff6b35;
        }
        
        .coach-info {
            text-align: center;
            margin-bottom: 3rem;
            font-size: 1.2rem;
            opacity: 0.9;
        }
        
        .schools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .school-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 2rem;
            border-radius: 15px;
            border: 2px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .school-card:hover {
            transform: translateY(-5px);
            border-color: #ff6b35;
        }
        
        .school-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .school-logo {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            font-size: 1.2rem;
        }
        
        .school-info h3 {
            font-size: 1.3rem;
            margin-bottom: 0.25rem;
        }
        
        .school-info .nickname {
            color: #ff6b35;
            font-weight: bold;
        }
        
        .school-info .conference {
            opacity: 0.8;
            font-size: 0.9rem;
        }
        
        .prestige {
            margin-top: 1rem;
            color: #ffd700;
        }
        
        .actions {
            text-align: center;
        }
        
        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            margin: 0.5rem;
            background: linear-gradient(45deg, #ff6b35, #f7931e);
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .btn:hover {
            transform: translateY(-2px);
        }
        
        .btn.secondary {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🏫 Choose Your School</h1>
        <div class="coach-info">
            Welcome Coach <strong><%= coachName %></strong>! Select the program you want to lead to glory.
        </div>
        
        <div class="schools-grid">
            <% schools.forEach(function(school) { %>
                <div class="school-card" onclick="selectSchool('<%= school.id %>')">
                    <div class="school-header">
                        <div class="school-logo" style="background: linear-gradient(45deg, <%= school.colors[0] %>, <%= school.colors[1] %>);">
                            <%= school.abbreviation %>
                        </div>
                        <div class="school-info">
                            <h3><%= school.name %></h3>
                            <div class="nickname"><%= school.nickname %></div>
                            <div class="conference"><%= school.conference %></div>
                        </div>
                    </div>
                    <div class="prestige">
                        Prestige: <% for(let i = 0; i < school.prestige; i++) { %>★<% } %><% for(let i = school.prestige; i < 5; i++) { %>☆<% } %>
                    </div>
                </div>
            <% }); %>
        </div>
        
        <div class="actions">
            <a href="/coach" class="btn secondary">Back</a>
        </div>
    </div>

    <script>
        function selectSchool(schoolId) {
            // Create form and submit
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/create';
            
            const coachInput = document.createElement('input');
            coachInput.type = 'hidden';
            coachInput.name = 'coachName';
            coachInput.value = '<%= coachName %>';
            
            const schoolInput = document.createElement('input');
            schoolInput.type = 'hidden';
            schoolInput.name = 'schoolId';
            schoolInput.value = schoolId;
            
            form.appendChild(coachInput);
            form.appendChild(schoolInput);
            document.body.appendChild(form);
            form.submit();
        }
    </script>
</body>
</html>