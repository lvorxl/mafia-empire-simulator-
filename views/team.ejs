<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Management - <%= gameState.school.nickname %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #0a0e1a 0%, #1a2332 100%);
            color: white;
            min-height: 100vh;
        }
        
        .header {
            background: rgba(255, 255, 255, 0.05);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .school-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .school-logo {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
        }
        
        .school-details h2 {
            color: #ff6b35;
            margin-bottom: 0.25rem;
        }
        
        .nav-menu {
            background: rgba(255, 255, 255, 0.03);
            padding: 1rem 2rem;
            display: flex;
            gap: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .nav-link {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            transition: all 0.3s ease;
        }
        
        .nav-link:hover, .nav-link.active {
            background: rgba(255, 107, 53, 0.2);
            color: #ff6b35;
        }
        
        .container {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .page-title {
            text-align: center;
            font-size: 2.5rem;
            color: #ff6b35;
            margin-bottom: 2rem;
        }
        
        .team-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        
        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .stat-card h3 {
            color: #ff6b35;
            margin-bottom: 1rem;
        }
        
        .stat-value {
            font-size: 3rem;
            font-weight: bold;
            color: #ff6b35;
            margin-bottom: 0.5rem;
        }
        
        .practice-section {
            background: rgba(255, 255, 255, 0.05);
            padding: 2rem;
            border-radius: 15px;
            margin-bottom: 2rem;
        }
        
        .practice-section h3 {
            color: #ff6b35;
            margin-bottom: 1rem;
            text-align: center;
        }
        
        .practice-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }
        
        .practice-option {
            background: rgba(255, 255, 255, 0.05);
            padding: 1.5rem;
            border-radius: 10px;
            text-align: center;
            border: 2px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        
        .practice-option:hover {
            border-color: #ff6b35;
            transform: translateY(-2px);
        }
        
        .practice-option h4 {
            color: #ff6b35;
            margin-bottom: 1rem;
        }
        
        .practice-option p {
            opacity: 0.8;
            margin-bottom: 1rem;
        }
        
        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: linear-gradient(45deg, #ff6b35, #f7931e);
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .btn:hover {
            transform: translateY(-2px);
        }
        
        .btn.secondary {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
        
        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        
        .actions {
            text-align: center;
            margin-top: 2rem;
        }
        
        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            text-align: center;
        }
        
        .alert.success {
            background: rgba(40, 167, 69, 0.2);
            border: 1px solid rgba(40, 167, 69, 0.3);
            color: #28a745;
        }
        
        .alert.error {
            background: rgba(220, 53, 69, 0.2);
            border: 1px solid rgba(220, 53, 69, 0.3);
            color: #dc3545;
        }
        
        @media (max-width: 768px) {
            .nav-menu {
                flex-wrap: wrap;
                gap: 1rem;
            }
            
            .team-stats {
                grid-template-columns: 1fr;
            }
            
            .practice-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="school-info">
            <div class="school-logo" style="background: linear-gradient(45deg, <%= gameState.school.colors[0] %>, <%= gameState.school.colors[1] %>);">
                <%= gameState.school.abbreviation %>
            </div>
            <div class="school-details">
                <h2><%= gameState.school.nickname %> Dynasty</h2>
                <div>Coach <%= gameState.coach.name %> • <%= gameState.season %> Season</div>
            </div>
        </div>
        <div class="season-info">
            <div class="record"><%= gameState.record.wins %>-<%= gameState.record.losses %></div>
            <div>Week <%= gameState.week %></div>
        </div>
    </div>
    
    <nav class="nav-menu">
        <a href="/game" class="nav-link">🏠 Dashboard</a>
        <a href="/team" class="nav-link active">👥 Team</a>
        <a href="/recruiting" class="nav-link">🔍 Recruiting</a>
        <a href="/schedule" class="nav-link">📅 Schedule</a>
    </nav>
    
    <div class="container">
        <h1 class="page-title">👥 Team Management</h1>
        
        <% if (typeof result !== 'undefined') { %>
            <div class="alert <%= result === 'success' ? 'success' : 'error' %>">
                <% if (result === 'success') { %>
                    Practice completed successfully! Your team has improved.
                <% } else { %>
                    Practice failed. You may not have enough practice points.
                <% } %>
            </div>
        <% } %>
        
        <div class="team-stats">
            <div class="stat-card">
                <h3>📊 Overall Rating</h3>
                <div class="stat-value"><%= gameState.team.overall %></div>
                <p>Team's combined strength</p>
            </div>
            
            <div class="stat-card">
                <h3>🏃 Offense</h3>
                <div class="stat-value"><%= gameState.team.offense %></div>
                <p>Scoring ability</p>
            </div>
            
            <div class="stat-card">
                <h3>🛡️ Defense</h3>
                <div class="stat-value"><%= gameState.team.defense %></div>
                <p>Stopping opponents</p>
            </div>
            
            <div class="stat-card">
                <h3>😊 Morale</h3>
                <div class="stat-value"><%= gameState.team.morale %></div>
                <p>Team spirit</p>
            </div>
        </div>
        
        <div class="practice-section">
            <h3>🏃 Practice Options (Points: <%= gameState.resources.practicePoints %>)</h3>
            <div class="practice-grid">
                <div class="practice-option">
                    <h4>🏃 Offensive Practice</h4>
                    <p>Improve your team's scoring ability and offensive coordination.</p>
                    <form action="/practice/offense" method="POST" style="display: inline;">
                        <button type="submit" class="btn" <%= gameState.resources.practicePoints <= 0 ? 'disabled' : '' %>>
                            Practice Offense
                        </button>
                    </form>
                </div>
                
                <div class="practice-option">
                    <h4>🛡️ Defensive Practice</h4>
                    <p>Strengthen your defense and improve stopping power.</p>
                    <form action="/practice/defense" method="POST" style="display: inline;">
                        <button type="submit" class="btn" <%= gameState.resources.practicePoints <= 0 ? 'disabled' : '' %>>
                            Practice Defense
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="actions">
            <a href="/game" class="btn secondary">🏠 Back to Dashboard</a>
        </div>
    </div>
</body>
</html>