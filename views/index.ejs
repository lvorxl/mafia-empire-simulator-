<% layout('layout') %>

<% contentFor('head') %>
<style>
    .hero {
        text-align: center;
        padding: 4rem 0;
    }

    .hero h1 {
        font-size: 4rem;
        font-weight: 800;
        margin-bottom: 1rem;
        background: linear-gradient(45deg, #ffffff, #e0e0e0);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero p {
        font-size: 1.3rem;
        opacity: 0.9;
        margin-bottom: 3rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-actions {
        display: flex;
        gap: 2rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin: 4rem 0;
    }

    .feature {
        background: rgba(255, 255, 255, 0.05);
        padding: 2rem;
        border-radius: 15px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease;
    }

    .feature:hover {
        transform: translateY(-5px);
    }

    .feature i {
        font-size: 3rem;
        color: #ff6b35;
        margin-bottom: 1rem;
    }

    .feature h3 {
        margin-bottom: 1rem;
        color: #ff6b35;
    }

    .stats {
        background: rgba(255, 255, 255, 0.05);
        padding: 3rem;
        border-radius: 20px;
        text-align: center;
        margin: 3rem 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .stat-item {
        text-align: center;
    }

    .stat-number {
        font-size: 3rem;
        font-weight: 800;
        color: #ff6b35;
        display: block;
    }

    .stat-label {
        opacity: 0.8;
        font-size: 1.1rem;
    }

    @media (max-width: 768px) {
        .hero h1 {
            font-size: 2.5rem;
        }
        
        .hero-actions {
            flex-direction: column;
            align-items: center;
        }
    }
</style>
<% endContentFor %>

<div class="fade-in">
    <section class="hero">
        <h1>Build Your Dynasty</h1>
        <p>Lead your college football program to championship glory. Recruit top talent, develop your team, and create a legendary dynasty that will be remembered forever.</p>
        
        <div class="hero-actions">
            <% if (hasExistingGame) { %>
                <a href="/dashboard" class="btn primary">
                    <i class="fas fa-play"></i>
                    Continue Dynasty
                </a>
                <a href="/create-coach" class="btn secondary">
                    <i class="fas fa-plus"></i>
                    Start New Career
                </a>
            <% } else { %>
                <a href="/create-coach" class="btn primary">
                    <i class="fas fa-plus"></i>
                    Start Your Dynasty
                </a>
                <a href="/leaderboard" class="btn secondary">
                    <i class="fas fa-trophy"></i>
                    View Leaderboard
                </a>
            <% } %>
        </div>
    </section>

    <section class="features">
        <div class="feature">
            <i class="fas fa-users"></i>
            <h3>Team Management</h3>
            <p>Build and manage your roster with detailed player ratings, positions, and development paths. Make strategic decisions about your depth chart and player development.</p>
        </div>
        
        <div class="feature">
            <i class="fas fa-search"></i>
            <h3>Realistic Recruiting</h3>
            <p>Scout and recruit talented high school players. Use your recruiting points wisely and leverage your program's prestige to land top prospects.</p>
        </div>
        
        <div class="feature">
            <i class="fas fa-gamepad"></i>
            <h3>Game Simulation</h3>
            <p>Experience realistic game outcomes based on your team's ratings, opponent strength, and home field advantage. Every game matters in your quest for glory.</p>
        </div>
        
        <div class="feature">
            <i class="fas fa-trophy"></i>
            <h3>Dynasty Building</h3>
            <p>Build your program's prestige over multiple seasons. Win games, recruit better players, and establish your school as a college football powerhouse.</p>
        </div>
        
        <div class="feature">
            <i class="fas fa-dumbbell"></i>
            <h3>Practice System</h3>
            <p>Allocate practice points to improve your team's offense, defense, and special teams. Strategic practice management is key to success.</p>
        </div>
        
        <div class="feature">
            <i class="fas fa-chart-line"></i>
            <h3>Detailed Analytics</h3>
            <p>Track your program's progress with comprehensive statistics, season records, and performance metrics across multiple seasons.</p>
        </div>
    </section>

    <section class="stats">
        <h2><i class="fas fa-university"></i> Choose From Elite Programs</h2>
        <p>Select from <%= schools.length %> authentic college football programs, each with unique characteristics, traditions, and challenges.</p>
        
        <div class="stats-grid">
            <div class="stat-item">
                <span class="stat-number"><%= schools.length %></span>
                <span class="stat-label">College Programs</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">5</span>
                <span class="stat-label">Major Conferences</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">12</span>
                <span class="stat-label">Games Per Season</span>
            </div>
            <div class="stat-item">
                <span class="stat-number">50+</span>
                <span class="stat-label">Recruits Available</span>
            </div>
        </div>
    </section>

    <% if (hasExistingGame) { %>
        <section class="card">
            <h2><i class="fas fa-save"></i> Welcome Back, Coach!</h2>
            <p>You have an active dynasty in progress. Continue building your championship program or start fresh with a new career.</p>
            <div style="margin-top: 2rem; display: flex; gap: 1rem; flex-wrap: wrap;">
                <a href="/dashboard" class="btn primary">
                    <i class="fas fa-play"></i>
                    Continue Current Dynasty
                </a>
                <form action="/reset-game" method="POST" style="display: inline;">
                    <button type="submit" class="btn secondary" onclick="return confirm('Are you sure you want to start over? This will delete your current progress.')">
                        <i class="fas fa-refresh"></i>
                        Start Over
                    </button>
                </form>
            </div>
        </section>
    <% } %>
</div>

<% contentFor('scripts') %>
<script>
    // Add some interactive elements
    document.addEventListener('DOMContentLoaded', function() {
        // Animate stats on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fadeIn 0.6s ease-out';
                }
            });
        }, observerOptions);

        document.querySelectorAll('.feature, .stat-item').forEach(el => {
            observer.observe(el);
        });
    });
</script>
<% endContentFor %>