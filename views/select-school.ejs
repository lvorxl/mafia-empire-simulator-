<% layout('layout') %>

<% contentFor('head') %>
<style>
    .selection-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .selection-header h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #ff6b35;
    }

    .coach-summary {
        background: rgba(255, 255, 255, 0.05);
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .coach-summary h3 {
        color: #ff6b35;
        margin-bottom: 0.5rem;
    }

    .schools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .school-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        padding: 2rem;
        border: 2px solid rgba(255, 255, 255, 0.1);
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .school-card:hover {
        transform: translateY(-5px);
        border-color: #ff6b35;
        box-shadow: 0 10px 30px rgba(255, 107, 53, 0.2);
    }

    .school-card.selected {
        border-color: #28a745;
        background: rgba(40, 167, 69, 0.1);
    }

    .school-header {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .school-logo {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 1.5rem;
        color: white;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .school-info h3 {
        font-size: 1.4rem;
        margin-bottom: 0.25rem;
    }

    .school-info .nickname {
        font-size: 1.1rem;
        color: #ff6b35;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .school-info .conference {
        opacity: 0.8;
        font-size: 0.9rem;
    }

    .school-details {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .school-details p {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
        opacity: 0.9;
    }

    .school-details i {
        color: #ff6b35;
        width: 16px;
    }

    .prestige-stars {
        color: #ffd700;
        font-size: 1.2rem;
        margin: 1rem 0;
    }

    .school-description {
        font-style: italic;
        opacity: 0.8;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .loading-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .loading-content {
        text-align: center;
        color: #28a745;
    }

    .loading-content i {
        font-size: 2rem;
        margin-bottom: 1rem;
        animation: spin 1s linear infinite;
    }

    .selection-actions {
        text-align: center;
        margin-top: 2rem;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    @media (max-width: 768px) {
        .schools-grid {
            grid-template-columns: 1fr;
        }
        
        .school-details {
            grid-template-columns: 1fr;
        }
    }
</style>
<% endContentFor %>

<div class="fade-in">
    <div class="selection-header">
        <h1><i class="fas fa-university"></i> Choose Your Program</h1>
        <p>Select the college football program you want to lead to championship glory.</p>
    </div>

    <div class="coach-summary">
        <h3>Coach Profile</h3>
        <p><strong><%= coachData.coachName %></strong> • <%= coachData.coachingStyle.charAt(0).toUpperCase() + coachData.coachingStyle.slice(1) %> Philosophy • <%= coachData.difficulty.charAt(0).toUpperCase() + coachData.difficulty.slice(1) %> Difficulty</p>
    </div>

    <div class="schools-grid">
        <% schools.forEach(function(school) { %>
            <div class="school-card" onclick="selectSchool('<%= school.id %>')">
                <div class="school-header">
                    <div class="school-logo" style="background: linear-gradient(45deg, <%= school.colors[0] %>, <%= school.colors[1] %>);">
                        <%= school.abbreviation %>
                    </div>
                    <div class="school-info">
                        <h3><%= school.name %></h3>
                        <div class="nickname"><%= school.nickname %></div>
                        <div class="conference"><%= school.conference %><% if (school.division) { %> <%= school.division %><% } %></div>
                    </div>
                </div>

                <div class="school-details">
                    <p><i class="fas fa-map-marker-alt"></i> <%= school.location %></p>
                    <p><i class="fas fa-calendar"></i> Founded <%= school.founded %></p>
                    <p><i class="fas fa-building"></i> <%= school.stadium %></p>
                    <p><i class="fas fa-users"></i> <%= school.capacity.toLocaleString() %> capacity</p>
                </div>

                <div class="prestige-stars">
                    <i class="fas fa-star"></i> Prestige: 
                    <% for(let i = 0; i < school.prestige; i++) { %>★<% } %>
                    <% for(let i = school.prestige; i < 5; i++) { %>☆<% } %>
                </div>

                <div class="school-description">
                    <%= school.description %>
                </div>

                <div class="loading-overlay">
                    <div class="loading-content">
                        <i class="fas fa-football-ball"></i>
                        <div><strong>Creating Your Dynasty...</strong></div>
                        <div>Setting up your program at <%= school.name %></div>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>

    <div class="selection-actions">
        <a href="/create-coach" class="btn secondary">
            <i class="fas fa-arrow-left"></i>
            Back to Coach Creation
        </a>
    </div>
</div>

<% contentFor('scripts') %>
<script>
    let selectedSchoolId = null;

    function selectSchool(schoolId) {
        if (selectedSchoolId) return; // Prevent double-click

        selectedSchoolId = schoolId;
        
        // Remove previous selections
        document.querySelectorAll('.school-card').forEach(card => {
            card.classList.remove('selected');
        });
        
        // Select current card and show loading
        const selectedCard = event.currentTarget;
        selectedCard.classList.add('selected');
        
        const loadingOverlay = selectedCard.querySelector('.loading-overlay');
        loadingOverlay.classList.add('active');
        
        // Create form and submit
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/create-game';
        form.style.display = 'none';
        
        // Add form fields
        const fields = {
            coachName: '<%= coachData.coachName %>',
            coachingStyle: '<%= coachData.coachingStyle %>',
            difficulty: '<%= coachData.difficulty %>',
            schoolId: schoolId
        };
        
        Object.entries(fields).forEach(([name, value]) => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        });
        
        document.body.appendChild(form);
        
        // Submit after a short delay for better UX
        setTimeout(() => {
            form.submit();
        }, 1500);
    }

    // Add hover effects
    document.addEventListener('DOMContentLoaded', function() {
        const schoolCards = document.querySelectorAll('.school-card');
        
        schoolCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                if (!selectedSchoolId) {
                    this.style.transform = 'translateY(-5px)';
                }
            });
            
            card.addEventListener('mouseleave', function() {
                if (!selectedSchoolId) {
                    this.style.transform = 'translateY(0)';
                }
            });
        });
    });
</script>
<% endContentFor %>