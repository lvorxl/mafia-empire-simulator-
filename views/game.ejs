<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= gameState.school.nickname %> Dynasty</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #0a0e1a 0%, #1a2332 100%);
            color: white;
            min-height: 100vh;
        }
        
        .header {
            background: rgba(255, 255, 255, 0.05);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .school-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .school-logo {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
        }
        
        .school-details h2 {
            color: #ff6b35;
            margin-bottom: 0.25rem;
        }
        
        .season-info {
            text-align: right;
        }
        
        .season-info .record {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ff6b35;
        }
        
        .nav-menu {
            background: rgba(255, 255, 255, 0.03);
            padding: 1rem 2rem;
            display: flex;
            gap: 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .nav-link {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            transition: all 0.3s ease;
        }
        
        .nav-link:hover, .nav-link.active {
            background: rgba(255, 107, 53, 0.2);
            color: #ff6b35;
        }
        
        .container {
            padding: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .card {
            background: rgba(255, 255, 255, 0.05);
            padding: 2rem;
            border-radius: 15px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .card h3 {
            color: #ff6b35;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .stat-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 5px;
        }
        
        .stat-value {
            font-weight: bold;
            color: #ff6b35;
        }
        
        .next-game {
            text-align: center;
            padding: 1rem;
            background: rgba(255, 107, 53, 0.1);
            border-radius: 10px;
            border: 1px solid rgba(255, 107, 53, 0.3);
        }
        
        .matchup {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            margin: 1rem 0;
        }
        
        .team {
            text-align: center;
        }
        
        .team-logo {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: white;
            margin: 0 auto 0.5rem;
        }
        
        .vs {
            font-size: 1.5rem;
            font-weight: bold;
            color: #ff6b35;
        }
        
        .news-item {
            padding: 1rem;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            margin-bottom: 1rem;
            border-left: 3px solid #ff6b35;
        }
        
        .actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
            flex-wrap: wrap;
        }
        
        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: linear-gradient(45deg, #ff6b35, #f7931e);
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease;
        }
        
        .btn:hover {
            transform: translateY(-2px);
        }
        
        .btn.secondary {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
        }
        
        @media (max-width: 768px) {
            .header {
                flex-direction: column;
                gap: 1rem;
            }
            
            .nav-menu {
                flex-wrap: wrap;
                gap: 1rem;
            }
            
            .matchup {
                flex-direction: column;
                gap: 1rem;
            }
            
            .actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="school-info">
            <div class="school-logo" style="background: linear-gradient(45deg, <%= gameState.school.colors[0] %>, <%= gameState.school.colors[1] %>);">
                <%= gameState.school.abbreviation %>
            </div>
            <div class="school-details">
                <h2><%= gameState.school.nickname %> Dynasty</h2>
                <div>Coach <%= gameState.coach.name %> • <%= gameState.season %> Season</div>
            </div>
        </div>
        <div class="season-info">
            <div class="record"><%= gameState.record.wins %>-<%= gameState.record.losses %></div>
            <div>Week <%= gameState.week %></div>
        </div>
    </div>
    
    <nav class="nav-menu">
        <a href="/game" class="nav-link active">🏠 Dashboard</a>
        <a href="/team" class="nav-link">👥 Team</a>
        <a href="/recruiting" class="nav-link">🔍 Recruiting</a>
        <a href="/schedule" class="nav-link">📅 Schedule</a>
    </nav>
    
    <div class="container">
        <div class="dashboard-grid">
            <!-- Team Status -->
            <div class="card">
                <h3>📊 Team Status</h3>
                <div class="stat-grid">
                    <div class="stat-item">
                        <span>Overall</span>
                        <span class="stat-value"><%= gameState.team.overall %></span>
                    </div>
                    <div class="stat-item">
                        <span>Offense</span>
                        <span class="stat-value"><%= gameState.team.offense %></span>
                    </div>
                    <div class="stat-item">
                        <span>Defense</span>
                        <span class="stat-value"><%= gameState.team.defense %></span>
                    </div>
                    <div class="stat-item">
                        <span>Morale</span>
                        <span class="stat-value"><%= gameState.team.morale %></span>
                    </div>
                </div>
            </div>

            <!-- Resources -->
            <div class="card">
                <h3>💰 Resources</h3>
                <div class="stat-grid">
                    <div class="stat-item">
                        <span>Practice Points</span>
                        <span class="stat-value"><%= gameState.resources.practicePoints %></span>
                    </div>
                    <div class="stat-item">
                        <span>Recruiting Points</span>
                        <span class="stat-value"><%= gameState.resources.recruitingPoints %></span>
                    </div>
                </div>
            </div>

            <!-- Next Game -->
            <div class="card">
                <h3>🎮 Next Game</h3>
                <% 
                    const nextGame = gameState.schedule.find(game => !game.played);
                    if (nextGame) {
                        const homeTeam = nextGame.isHome ? gameState.school : nextGame.opponent;
                        const awayTeam = nextGame.isHome ? nextGame.opponent : gameState.school;
                %>
                    <div class="next-game">
                        <h4>Week <%= nextGame.week %></h4>
                        <div class="matchup">
                            <div class="team">
                                <div class="team-logo" style="background: linear-gradient(45deg, <%= awayTeam.colors[0] %>, <%= awayTeam.colors[1] %>);">
                                    <%= awayTeam.abbreviation %>
                                </div>
                                <div><%= awayTeam.nickname %></div>
                            </div>
                            <div class="vs">@</div>
                            <div class="team">
                                <div class="team-logo" style="background: linear-gradient(45deg, <%= homeTeam.colors[0] %>, <%= homeTeam.colors[1] %>);">
                                    <%= homeTeam.abbreviation %>
                                </div>
                                <div><%= homeTeam.nickname %></div>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <p>Season Complete!</p>
                <% } %>
            </div>

            <!-- Recent News -->
            <div class="card">
                <h3>📰 Recent News</h3>
                <% gameState.news.slice(-3).reverse().forEach(function(newsItem) { %>
                    <div class="news-item">
                        <p><%= newsItem %></p>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="actions">
            <% if (gameState.schedule.find(game => !game.played)) { %>
                <% const nextGameIndex = gameState.schedule.findIndex(game => !game.played); %>
                <form action="/simulate/<%= nextGameIndex %>" method="POST" style="display: inline;">
                    <button type="submit" class="btn">🎮 Simulate Next Game</button>
                </form>
            <% } %>
            
            <% if (gameState.resources.practicePoints > 0) { %>
                <a href="/team" class="btn secondary">🏃 Practice Team</a>
            <% } %>
            
            <% if (gameState.resources.recruitingPoints > 0) { %>
                <a href="/recruiting" class="btn secondary">🔍 Recruit Players</a>
            <% } %>
            
            <form action="/advance" method="POST" style="display: inline;">
                <button type="submit" class="btn secondary">⏭️ Advance Week</button>
            </form>
        </div>
    </div>
</body>
</html>